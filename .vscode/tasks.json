{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}/documentation"
  },
  "tasks": [
    {
      "label": "Virtual Environment: Set Up & Install requirements",
      "type": "shell",
      "command": "virtualenv .venv; .venv/bin/pip install -r requirements.txt",
      "problemMatcher": [],
      "presentation": {
        "clear": true,
        "group": "zensical"
      },
      "detail": "Creates a virtual environment and installs the required dependencies."
    },
    {
      "label": "Zensical: Serve (Live Preview)",
      "type": "shell",
      "command": ".venv/bin/zensical serve",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "clear": true,
        "group": "zensical"
      },
      "detail": "Starts the local live-reload development server."
    },
    {
      "label": "Zensical: Build (Clean)",
      "type": "shell",
      "command": ".venv/bin/zensical build --clean",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "clear": true,
        "group": "zensical"
      },
      "detail": "Cleans the previous output and compiles the static site."
    }
  ]
}
